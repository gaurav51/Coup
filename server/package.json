{
  "name": "coup-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Authoritative multiplayer Coup server. The table is driven entirely by Socket.io events.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test",
    "host:local": "node scripts/local-host.mjs"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "google-auth-library": "^11.3.1",
    "jose": "^6.2.12",
    "mongodb": "^7.7.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "socket.io-client": "^4.8.1"
  }
}
